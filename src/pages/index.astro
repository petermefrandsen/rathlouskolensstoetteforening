---
import Layout from '../layouts/Layout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import QuoteCarousel from '../components/home/QuoteCarousel.astro';
import GallerySection from '../components/home/GallerySection.astro';
import ContactSection from '../components/home/ContactSection.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

// Initialize Keystatic reader for data fetching
const reader = createReader(process.cwd(), keystaticConfig);
const settings = await reader.singletons.settings.read();

// Quotes from CMS (array up to 5 items)
const quotes = (settings?.quotes || []) as { quote: string; author: string }[];

// Gallery Images from CMS
const galleryImages = (settings?.galleryImages || []) as {
  image: string;
  caption?: string;
  tag?: string;
}[];

// Fallbacks if not yet edited in Keystatic CMS
const heroTitle = settings?.heroTitle || 'Rathlouskolens Støtteforening';
const heroSubtitle = settings?.heroSubtitle || 'Støtter op om skolen for elever og personale';
const heroImage = settings?.heroImage || 'https://lh3.googleusercontent.com/aida-public/AB6AXuDRVstlz48ngbeYLuSEsBgDQdtNror6Ai-PhUh2Lp8s4cQkdbCIXQVK_Gxtm7qWixciq-7acAyVz7KPGkjaO7m166qLhMMtTNQcCKkqR9ffg2wD9FLchjw8CZBHGq7o2eqqN2Z1WVBOtkwRHeyIBkOHw5nBPd34jFZ2GWkydwpoLuvYptDFsBvkux5MH6pcgj8l0epIFkDp-b52BQ3uFg6l_TMu8RFlRYYE8twkzK7uONBN0z3b7RgFbobnX3qJfa_khg';
const mobilePayNumber = settings?.mobilePayNumber || '86561844';
const mobilePayQr = settings?.mobilePayQr || 'https://lh3.googleusercontent.com/aida-public/AB6AXuAQI86rJpubHtLBfzayBgHWKSA7LoQE5Mw8kb2arKLr0seiopfGT6eY-vvAWjMVTKmiBcxSoroeFIGWKYY_PxD6zLnCBL2pawvCZiasEGu0G0bukFqvV2xaP0cjl_R8H7Dbb4ltwSkRFzbHtIdYQycDDV0zmgmlXDLE5asPMCV7cL7RnlddirL6CraeHTTlE9iNM6Ykko_pJtDvhMoD2ZGl3am-WZCaUDh8TWPPxJ7k0F3xS0UFqvmE';
const membershipFee = settings?.membershipFee || 'Kun 150 kroner per år for hele husstanden';
const grantEmail = settings?.grantEmail || 'stoetteforeningen@rathlouskolen.com';
const cvr = settings?.cvr || '86561844';
const address = settings?.address || 'Rosensgade 83, 8300 Odder';
const phone = settings?.phone || '86561844';
const logoUrl = 'https://lh3.googleusercontent.com/aida/AP1WRLv-auhEXEYBuE8g7TwTMU2UFfhUG9gA1b8D_iNIvjS5NLvMO3AKxSYhxJL-BYQlnUfOlEVdJODwsztw4d_poqtcwcMH_8OOs-mMu61Iu64JCECiqVJHBOha78TPB23_F9k46jYIbNMHmgMLQztOlefqZtujkE2fXKG1eA8w-yVkhwyDJpcp_7Uts5XuGj7mocZPvFZUO--iLyJnPCg4i3BXzW3zQiMhzrocgDs2lmmOH_8P9YQru2uuSw';
// Document links: Uploaded file takes precedence over URL. If file is removed, falls back to URL or '#'
const bylawsHref = (settings?.bylawsFile && settings.bylawsFile.trim()) 
  ? settings.bylawsFile 
  : (settings?.bylawsUrl && settings.bylawsUrl.trim()) 
    ? settings.bylawsUrl 
    : '#';

const privacyHref = (settings?.privacyFile && settings.privacyFile.trim()) 
  ? settings.privacyFile 
  : (settings?.privacyUrl && settings.privacyUrl.trim()) 
    ? settings.privacyUrl 
    : '#';

const termsHref = (settings?.termsFile && settings.termsFile.trim()) 
  ? settings.termsFile 
  : (settings?.termsUrl && settings.termsUrl.trim()) 
    ? settings.termsUrl 
    : '#';

const hasGallery = galleryImages.length > 0;

const okTitle = settings?.okTitle || 'Støt Rathlouskolen med OK';
const okSubtitle = settings?.okSubtitle || 'Støt Rathlouskolens Støtteforening kvit og frit, hver gang du tanker, lader eller vasker hos OK.';
const okInfoText = settings?.okInfoText || 'Når du tilknytter dit OK Benzinkort eller OK Appen til Rathlouskolens Støtteforening (Sponsornummer: 784473), støtter OK vores forening uden at det koster dig en ekstra øre.';
const okSponsorNumber = settings?.okSponsorNumber || '784473';
const okLink = settings?.okLink || 'https://www.ok.dk/privat/hjaelp/stoet-lokalt/hvordan-stoetter-jeg-lokalt-med-ok';
const okBanner = settings?.okBanner || '/images/support/ok-banner.png';
const okLogo = settings?.okLogo || '/images/support/ok-logo.svg';

const donationTitle = settings?.donationTitle || 'Giv et engangsbidrag';
const donationText = settings?.donationText || 'Ønsker du eller din virksomhed at støtte med et valgfrit beløb, sponsorat eller gave? Alle bidrag gør en direkte forskel for elever og skole.';

// MobilePay Instructions formatting: replaces @mobilepay placeholder or defaults cleanly
const rawMobilePayInstructions = settings?.mobilePayInstructions || 'Scan QR-koden med MobilePay eller overfør til boks @mobilepay';
const mobilePayParts = rawMobilePayInstructions.split('@mobilepay');
---

<Layout title={heroTitle} description={heroSubtitle}>
  <Header logoUrl={logoUrl} hasGallery={hasGallery} />

  <main class="max-w-container-max mx-auto px-4 md:px-6 pb-20">
    <!-- Hero Section -->
    <section class="mt-8 md:mt-12 relative rounded-xl overflow-hidden min-h-[360px] md:min-h-[420px] flex items-center justify-center p-6 md:p-12 bg-sky-tint">
      <div
        class="absolute inset-0 z-0 bg-cover bg-center bg-no-repeat"
        style={`background-image: url('${heroImage}');`}
      ></div>
      <div class="relative z-10 text-center max-w-2xl flex flex-col items-center">
        <img
          alt="Logo"
          class="h-20 md:h-28 w-auto mx-auto mb-4 object-contain"
          src={logoUrl}
          style="filter: brightness(0) invert(1);"
        />
        <h1 class="text-3xl md:text-5xl font-bold tracking-tight mb-3 text-white">
          {heroTitle}
        </h1>
        <p class="text-lg md:text-2xl font-semibold text-white/95">
          {heroSubtitle}
        </p>
      </div>
    </section>

    <!-- About Section -->
    <section class="mt-16 md:mt-20 scroll-mt-24 md:scroll-mt-28 grid md:grid-cols-2 gap-6 md:gap-8 items-start" id="om-os">
      <div class="space-y-4">
        <h2 class="text-xl md:text-2xl font-semibold text-primary tracking-wide">
          {settings?.introTitle || 'OM STØTTEFORENINGEN'}
        </h2>
        <div class="space-y-3 text-base text-on-surface-variant leading-relaxed whitespace-pre-line">
          {settings?.introText || `Rathlouskolens støtteforening er en frivillig forening, som alle kan være medlem af.

Foreningen har til formål at støtte op om Rathlouskolen og samle midler ind, som kan være til glæde for elever og personale på skolen.

Alle skolens brugere kan søge om midler fra støtteforeningen.

Foreningens indtægter opstår ved forskellige arrangementer afholdt af Støtteforeningen. Desuden betales et kontingent fra medlemmerne på årligt 150 kr. Støtteforeningen tager også gerne imod sponsorater og gaver.`}
        </div>
      </div>

      <QuoteCarousel quotes={quotes} />
    </section>

    <!-- Support Section (Støt Foreningen) -->
    <section class="mt-16 md:mt-20 scroll-mt-24 md:scroll-mt-28 space-y-8" id="bliv-medlem">
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold text-primary mb-3">
          STØT RATHLOUSKOLEN
        </h2>
        <p class="text-base md:text-lg text-on-surface-variant">
          Der er flere måder, du kan støtte eleverne og skolen på. Vælg den løsning, der passer dig bedst.
        </p>
      </div>

      <!-- Support Grid: 1. Membership & 2. Donation -->
      <div class="grid md:grid-cols-2 gap-6 md:gap-8">
        <!-- 1. Become Member -->
        <div class="bg-sky-tint p-6 md:p-8 rounded-2xl border border-primary-fixed-dim flex flex-col justify-between text-center">
          <div>
            <div class="inline-flex items-center gap-1.5 bg-primary/10 text-primary text-xs font-semibold px-3 py-1 rounded-full mb-3">
              <span class="material-symbols-outlined text-sm" aria-hidden="true">card_membership</span>
              Fast Medlemskab
            </div>
            <h3 class="text-xl md:text-2xl font-bold text-primary mb-2">
              Meld dig ind i dag
            </h3>
            <p class="text-base font-medium text-on-surface mb-6">
              {membershipFee}
            </p>

            <div class="flex flex-col items-center justify-center gap-4 mb-6">
              <div class="bg-white p-3 rounded-xl shadow-sm border border-outline-variant/50">
                <img
                  class="w-36 h-36 md:w-44 md:h-44 object-cover rounded-lg"
                  alt="MobilePay QR-kode til medlemskab"
                  src={mobilePayQr}
                />
              </div>
              <p class="text-xs md:text-sm text-on-surface-variant max-w-xs">
                {
                  mobilePayParts.length > 1 ? (
                    <>
                      {mobilePayParts[0]}
                      <strong class="text-on-surface font-semibold">{mobilePayNumber}</strong>
                      {mobilePayParts[1]}
                    </>
                  ) : (
                    rawMobilePayInstructions
                  )
                }
              </p>
            </div>
          </div>

          <a
            href="https://mobilepay.dk"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-primary text-on-primary text-sm font-semibold px-6 py-3 rounded-xl hover:opacity-90 transition-opacity shadow-sm inline-block"
          >
            Meld dig ind via MobilePay
          </a>
        </div>

        <!-- 2. One-Time Donation / Sponsorship -->
        <div class="bg-surface-neutral p-6 md:p-8 rounded-2xl border border-surface-variant flex flex-col justify-between text-center">
          <div>
            <div class="inline-flex items-center gap-1.5 bg-secondary/10 text-secondary text-xs font-semibold px-3 py-1 rounded-full mb-3">
              <span class="material-symbols-outlined text-sm" aria-hidden="true">favorite</span>
              Engangsbidrag
            </div>
            <h3 class="text-xl md:text-2xl font-bold text-on-surface mb-2">
              {donationTitle}
            </h3>
            <p class="text-sm md:text-base text-on-surface-variant leading-relaxed mb-6">
              {donationText}
            </p>

            <div class="bg-white p-6 rounded-xl border border-outline-variant/60 shadow-sm mb-6 text-left space-y-3">
              <div class="flex items-center gap-3">
                <span class="material-symbols-outlined text-primary text-2xl" aria-hidden="true">qr_code_2</span>
                <div>
                  <span class="text-xs text-on-surface-variant uppercase font-semibold">MobilePay Boks</span>
                  <p class="text-base font-bold text-on-surface">{mobilePayNumber}</p>
                </div>
              </div>
              <div class="border-t border-outline-variant/50 pt-3 flex items-center gap-3">
                <span class="material-symbols-outlined text-primary text-2xl" aria-hidden="true">mail</span>
                <div>
                  <span class="text-xs text-on-surface-variant uppercase font-semibold">Sponsorat & Gaver</span>
                  <p class="text-sm font-medium text-on-surface">{grantEmail}</p>
                </div>
              </div>
            </div>
          </div>

          <a
            href={`mailto:${grantEmail}?subject=Sponsorat / Bidrag til Støtteforeningen`}
            class="border-2 border-primary text-primary hover:bg-primary hover:text-white transition-colors text-sm font-semibold px-6 py-3 rounded-xl inline-block shadow-sm"
          >
            Kontakt om sponsorat
          </a>
        </div>
      </div>

      <!-- 3. OK Sponsorship Hero / Feature Card -->
      <div class="bg-linear-to-br from-white to-sky-tint p-6 md:p-10 rounded-2xl border border-primary-fixed-dim shadow-sm grid md:grid-cols-12 gap-6 md:gap-8 items-center">
        <div class="md:col-span-7 space-y-4">
          <div class="flex items-center gap-3">
            {okLogo && (
              <img
                src={okLogo}
                alt="OK Logo"
                class="h-8 md:h-10 w-auto object-contain shrink-0"
              />
            )}
            <span class="inline-block bg-primary text-on-primary text-xs font-semibold px-3 py-1 rounded-full">
              Sponsorat
            </span>
          </div>

          <h3 class="text-2xl md:text-3xl font-bold text-primary tracking-tight">
            {okTitle}
          </h3>

          <p class="text-base font-semibold text-on-surface">
            {okSubtitle}
          </p>

          <p class="text-sm md:text-base text-on-surface-variant leading-relaxed whitespace-pre-line">
            {okInfoText}
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <div class="bg-white px-4 py-2 rounded-lg border border-outline-variant font-semibold text-sm text-primary flex items-center gap-2 shadow-xs">
              <span class="text-xs text-on-surface-variant uppercase font-normal">Sponsornummer:</span>
              <strong>{okSponsorNumber}</strong>
            </div>

            <a
              href={okLink}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-primary text-on-primary font-semibold text-sm px-6 py-2.5 rounded-lg hover:opacity-90 transition-opacity shadow-sm"
            >
              <span>Læs mere hos OK</span>
              <span class="material-symbols-outlined text-base" aria-hidden="true">open_in_new</span>
            </a>
          </div>
        </div>

        <div class="md:col-span-5 flex justify-center">
          {okBanner && (
            <img
              src={okBanner}
              alt="Støt Rathlouskolens Støtteforening med OK"
              class="rounded-xl shadow-md border border-outline-variant/60 w-full max-w-sm md:max-w-none object-contain hover:scale-[1.02] transition-transform duration-300"
            />
          )}
        </div>
      </div>
    </section>

    <!-- Applications Section -->
    <section class="mt-16 md:mt-20 scroll-mt-24 md:scroll-mt-28 bg-surface-neutral p-6 md:p-8 rounded-xl border border-surface-variant" id="ansogninger">
      <h2 class="text-xl md:text-2xl font-semibold text-primary mb-4">
        ANSØGNINGER
      </h2>
      <div class="grid md:grid-cols-2 gap-6 items-center">
        <div class="space-y-3 text-base text-on-surface-variant leading-relaxed">
          <p>
            Du ansøger støtteforeningen om midler ved at sende en ansøgning til støtteforeningens mail:{' '}
            <strong class="text-on-surface">{grantEmail}</strong>.
          </p>
          <p>
            Husk at beskrive, hvad det er du/I søger pengene til, hvornår pengene skal bruges og hvad I håber på at få ud af at modtage penge. Ansøgningerne markeres med tydelige afsendere.
          </p>
        </div>

        <div class="bg-white p-5 md:p-6 rounded-lg shadow-sm border border-outline-variant flex items-start gap-4">
          <span class="material-symbols-outlined text-primary text-3xl shrink-0" aria-hidden="true">
            calendar_month
          </span>
          <p class="text-sm md:text-base text-on-surface-variant">
            Støtteforeningen modtager løbende ansøgningerne, og de uddeles på <strong class="text-on-surface">Mod-til-at-glæde-dagen</strong> - fredag før påske.
          </p>
        </div>
      </div>
    </section>

    <!-- Gallery Section -->
    <GallerySection
      title={settings?.galleryTitle}
      subtitle={settings?.gallerySubtitle}
      images={galleryImages}
    />

    <!-- Contact Section -->
    <ContactSection
      title={settings?.contactTitle}
      subtitle={settings?.contactSubtitle}
      contactPerson={settings?.contactPerson}
      email={grantEmail}
      phone={phone}
      address={address}
      cvr={cvr}
    />
  </main>

  <Footer
    address={address}
    phone={phone}
    email={grantEmail}
    cvr={cvr}
    bylawsHref={bylawsHref}
    privacyHref={privacyHref}
    termsHref={termsHref}
  />
</Layout>
