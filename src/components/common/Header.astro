---
interface Props {
  logoUrl?: string;
  hasGallery?: boolean;
}

const {
  logoUrl = '/images/logo.png',
  hasGallery = false,
} = Astro.props;

const allNavItems = [
  { label: 'Om os', href: '#om-os' },
  { label: 'Støt', href: '#bliv-medlem' },
  { label: 'Ansøgninger', href: '#ansogninger' },
  { label: 'Galleri', href: '#galleri', show: hasGallery },
  { label: 'Kontakt', href: '#kontakt' },
];

const navItems = allNavItems.filter((item) => item.show !== false);
---

<header class="fixed top-0 left-0 w-full z-50 bg-surface/95 backdrop-blur-sm border-b border-outline-variant">
  <div class="max-w-container-max mx-auto flex justify-between items-center px-4 md:px-8 h-20">
    <a href="/" class="flex items-center gap-2.5 sm:gap-3 shrink-0 mr-4">
      <img
        alt="Rathlouskolens Støtteforening Logo"
        class="h-10 sm:h-12 md:h-12 w-auto object-contain shrink-0"
        src={logoUrl}
      />
      <!-- Desktop title text -->
      <span class="hidden md:block font-bold text-base lg:text-lg leading-snug tracking-tight text-on-surface whitespace-nowrap">
        Rathlouskolens Støtteforening
      </span>
    </a>

    <!-- Desktop Navigation (Including Kontakt) -->
    <nav class="hidden md:flex items-center gap-6 lg:gap-8" id="desktop-nav">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            data-nav-link={item.href}
            class="nav-link text-sm font-semibold tracking-wide transition-all duration-200 text-on-surface-variant hover:text-primary pb-1 border-b-2 border-transparent"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Desktop Primary CTA Button -->
    <div class="hidden md:flex items-center pl-4">
      <a
        href="#bliv-medlem"
        class="bg-primary text-on-primary text-sm font-semibold px-4 py-2 rounded-lg hover:opacity-90 transition-opacity shadow-sm"
      >
        Meld dig ind
      </a>
    </div>

    <!-- Mobile Action Button -->
    <div class="flex md:hidden items-center">
      <a
        href="#bliv-medlem"
        class="bg-primary text-on-primary text-xs font-semibold px-3 py-2 rounded-lg shrink-0"
      >
        Meld dig ind
      </a>
    </div>
  </div>
</header>

<script>
  let cleanupScrollSpy: (() => void) | null = null;

  function setupScrollSpy() {
    if (cleanupScrollSpy) {
      cleanupScrollSpy();
      cleanupScrollSpy = null;
    }

    const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
    if (!navLinks.length) return;

    const sections: HTMLElement[] = [];
    navLinks.forEach((link) => {
      const hash = link.getAttribute('href');
      if (hash && hash.startsWith('#')) {
        const target = document.querySelector<HTMLElement>(hash);
        if (target && !sections.includes(target)) {
          sections.push(target);
        }
      }
    });

    if (!sections.length) return;

    // Ensure sections are sorted by their visual position on the page
    sections.sort((a, b) => a.offsetTop - b.offsetTop);

    function setActiveLink(activeId: string | null) {
      navLinks.forEach((link) => {
        const href = link.getAttribute('href');
        const isActive = href === `#${activeId}`;
        if (isActive) {
          link.classList.add('text-primary', 'border-primary');
          link.classList.remove('text-on-surface-variant', 'border-transparent');
        } else {
          link.classList.remove('text-primary', 'border-primary');
          link.classList.add('text-on-surface-variant', 'border-transparent');
        }
      });
    }

    let isClickScrolling = false;
    let clickedTargetId: string | null = null;
    let scrollEndTimer: ReturnType<typeof setTimeout> | null = null;

    function clearClickLock() {
      isClickScrolling = false;
      if (scrollEndTimer) {
        clearTimeout(scrollEndTimer);
        scrollEndTimer = null;
      }
    }

    // When the user manually scrolls (mouse wheel, touch swipe, keyboard navigation),
    // clear the click lock so normal position tracking takes over.
    function onManualUserScroll() {
      isClickScrolling = false;
      clickedTargetId = null;
      if (scrollEndTimer) {
        clearTimeout(scrollEndTimer);
        scrollEndTimer = null;
      }
    }

    // Scroll listener for robust active anchor detection
    function onScroll() {
      if (isClickScrolling && clickedTargetId) {
        setActiveLink(clickedTargetId);
        if (scrollEndTimer) clearTimeout(scrollEndTimer);
        scrollEndTimer = setTimeout(clearClickLock, 150);
        return;
      }

      const scrollHeight = Math.max(
        document.documentElement.scrollHeight,
        document.body.scrollHeight
      );
      const isAtBottom =
        window.innerHeight + window.scrollY >= scrollHeight - 50;
      const scrollPosition = window.scrollY + 140; // Header height + offset

      let currentSectionId: string | null = null;

      if (isAtBottom && sections.length > 0) {
        // When at the bottom, if the user clicked a visible section near the bottom,
        // prioritize it. Otherwise, default to the last section in navigation.
        if (
          clickedTargetId &&
          sections.some((s) => s.id === clickedTargetId)
        ) {
          currentSectionId = clickedTargetId;
        } else {
          currentSectionId = sections[sections.length - 1].id;
        }
      } else {
        // User is not at the bottom; clear clicked target override
        if (!isClickScrolling) {
          clickedTargetId = null;
        }

        for (let i = sections.length - 1; i >= 0; i--) {
          const section = sections[i];
          if (section.offsetTop <= scrollPosition) {
            currentSectionId = section.id;
            break;
          }
        }

        // If at the very top, highlight the first section (Om os)
        if (!currentSectionId && window.scrollY < 200 && sections.length > 0) {
          currentSectionId = sections[0].id;
        }
      }

      if (currentSectionId) {
        setActiveLink(currentSectionId);
      }
    }

    // Listen to clicks on all header anchor links (nav items & CTA buttons)
    const allHeaderLinks = document.querySelectorAll<HTMLAnchorElement>('header a[href^="#"]');
    const onLinkClick = (e: MouseEvent) => {
      const link = e.currentTarget as HTMLAnchorElement;
      const href = link.getAttribute('href');
      if (!href || !href.startsWith('#')) return;
      const targetId = href.slice(1);
      const targetSection = sections.find((s) => s.id === targetId);
      if (!targetSection) return;

      isClickScrolling = true;
      clickedTargetId = targetId;
      setActiveLink(targetId);

      if (scrollEndTimer) clearTimeout(scrollEndTimer);
      scrollEndTimer = setTimeout(clearClickLock, 1000);
    };

    allHeaderLinks.forEach((link) => {
      link.addEventListener('click', onLinkClick);
    });

    const onHashChange = () => {
      const hash = window.location.hash.replace('#', '');
      if (hash && sections.some((s) => s.id === hash)) {
        clickedTargetId = hash;
        setActiveLink(hash);
      }
    };

    const abortController = new AbortController();
    const { signal } = abortController;

    window.addEventListener('scroll', onScroll, { passive: true, signal });
    window.addEventListener('scrollend', clearClickLock, { passive: true, signal });
    window.addEventListener('wheel', onManualUserScroll, { passive: true, signal });
    window.addEventListener('touchmove', onManualUserScroll, { passive: true, signal });
    window.addEventListener(
      'keydown',
      (e) => {
        if (['ArrowDown', 'ArrowUp', 'PageDown', 'PageUp', 'Space', 'Home', 'End'].includes(e.key)) {
          onManualUserScroll();
        }
      },
      { passive: true, signal }
    );
    window.addEventListener('resize', onScroll, { passive: true, signal });
    window.addEventListener('hashchange', onHashChange, { signal });

    // Initial state check on load
    const initialHash = window.location.hash.replace('#', '');
    if (initialHash && sections.some((s) => s.id === initialHash)) {
      clickedTargetId = initialHash;
      setActiveLink(initialHash);
    } else {
      onScroll();
    }

    cleanupScrollSpy = () => {
      abortController.abort();
      allHeaderLinks.forEach((link) => {
        link.removeEventListener('click', onLinkClick);
      });
      if (scrollEndTimer) {
        clearTimeout(scrollEndTimer);
      }
    };
  }

  setupScrollSpy();
  document.addEventListener('astro:page-load', setupScrollSpy);
</script>
